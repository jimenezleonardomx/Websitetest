# Copy to .env.local and fill in. NEVER commit .env.local.
# Values: Supabase dashboard -> Project Settings -> API

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Dashboard calls this the "Publishable key" (older projects: "anon public" key).
# Safe to expose in the browser -- it is gated by Row Level Security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Bypasses RLS. Never prefix with NEXT_PUBLIC_, never commit.
# SUPABASE_SECRET_KEY=
